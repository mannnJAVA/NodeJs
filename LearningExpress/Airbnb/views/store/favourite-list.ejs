<!DOCTYPE html>
<html lang="en">
  <%- include('../partials/head'); %>
  <body class="bg-gray-50 min-h-screen font-sans">
    <%- include('../partials/header'); %>

    <main class="py-16 max-w-5xl mx-auto px-4">
      <h1 class="text-4xl font-semibold text-gray-800 text-center">
        Favourite Homes
      </h1>

      <% if (!homes || homes.length === 0) { %>
      <p class="mt-5 text-center text-lg text-gray-500">
        Your wishlist is currently empty.
      </p>

      <div class="mt-8 text-center">
        <a
          href="/"
          class="inline-block bg-red-600 text-white px-8 py-3 rounded-lg shadow-md hover:bg-red-700 transition"
        >
          Go Back Home
        </a>
      </div>

      <% } else { %>

      <!-- Favourite cards -->
      <section
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-10"
      >
        <% homes.forEach(home => { %>

        <article
          class="border rounded-lg bg-white p-4 shadow hover:shadow-md transition"
        >
          <img
            src="<%= home.image %>"
            class="w-full h-48 object-cover rounded-md"
          />

          <h2 class="text-xl font-semibold mt-3"><%= home.title %></h2>
          <p class="text-gray-500 text-sm"><%= home.location %></p>

          <p class="mt-2 text-gray-800 font-medium">
            $<%= home.price %> / night
          </p>

          <a
            href="/homes/<%= home.id %>"
            class="mt-4 block w-full text-center bg-blue-600 text-white py-2 rounded-md hover:bg-blue-700 transition"
          >
            Show Details
          </a>

          <!-- ⭐ Reserve Button added below -->
          <a
            href="/reserve/<%= home.id %>"
            class="mt-2 block w-full text-center bg-red-600 text-white py-2 rounded-md hover:bg-red-700 transition"
          >
            Reserve This Home
          </a>
        </article>

        <% }); %>
      </section>

      <% } %>
    </main>
  </body>
</html>
