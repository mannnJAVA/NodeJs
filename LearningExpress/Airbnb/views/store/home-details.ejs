<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('../partials/head'); %>
  </head>

  <body class="bg-white font-sans">
    <!-- NAVBAR -->
    <%- include('../partials/header'); %>

    <!-- PAGE CONTENT -->
    <main class="max-w-7xl mx-auto px-6 py-8">
      <!-- Hero Section -->
      <section class="mb-8">
        <img
          src="<%= home.image %>"
          alt="<%= home.title %>"
          class="w-full h-96 object-cover rounded-lg shadow-lg"
        />
      </section>

      <!-- Title and Rating -->
      <section class="flex justify-between items-start mb-6">
        <div>
          <h1 class="text-4xl font-bold text-gray-900 mb-2">
            <%= home.title %>
          </h1>
          <div class="flex items-center gap-2 text-gray-600">
            <span class="text-yellow-500 text-xl">★</span>
            <span class="text-lg font-medium">4.8</span>
            <span class="text-gray-500">(120 reviews)</span>
            <span class="text-gray-500">·</span>
            <span class="text-gray-500">Superhost</span>
          </div>
        </div>
        <div class="flex gap-2">
          <button class="p-2 text-gray-600 hover:text-gray-900">
            <svg
              class="w-6 h-6"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.367 2.684 3 3 0 00-5.367-2.684z"
              ></path>
            </svg>
          </button>
          <button class="p-2 text-gray-600 hover:text-gray-900">
            <svg
              class="w-6 h-6"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
              ></path>
            </svg>
          </button>
        </div>
      </section>

      <!-- Details Grid -->
      <section class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
        <div class="space-y-4">
          <div class="flex items-center gap-4">
            <div
              class="w-12 h-12 bg-gray-200 rounded-full flex items-center justify-center"
            >
              <svg
                class="w-6 h-6 text-gray-600"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
                ></path>
              </svg>
            </div>
            <div>
              <p class="font-semibold text-gray-900">Hosted by John Doe</p>
              <p class="text-gray-600">Superhost · 5 years hosting</p>
            </div>
          </div>
          <div class="flex items-center gap-4">
            <div
              class="w-12 h-12 bg-gray-200 rounded-full flex items-center justify-center"
            >
              <svg
                class="w-6 h-6 text-gray-600"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                ></path>
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                ></path>
              </svg>
            </div>
            <div>
              <p class="font-semibold text-gray-900">Great location</p>
              <p class="text-gray-600">
                100% of recent guests gave the location a 5-star rating.
              </p>
            </div>
          </div>
        </div>
        <div class="bg-gray-50 p-6 rounded-lg shadow-sm">
          <div class="flex justify-between items-center mb-4">
            <span class="text-2xl font-bold text-gray-900"
              >₹<%= home.price %> / night</span
            >
            <span class="text-gray-600">(120 reviews)</span>
          </div>
          <div class="grid grid-cols-2 gap-2 mb-4">
            <div class="border rounded-lg p-3">
              <p class="text-sm font-medium text-gray-900">Check-in</p>
              <p class="text-sm text-gray-600">Add dates</p>
            </div>
            <div class="border rounded-lg p-3">
              <p class="text-sm font-medium text-gray-900">Check-out</p>
              <p class="text-sm text-gray-600">Add dates</p>
            </div>
          </div>
          <div class="border rounded-lg p-3 mb-4">
            <p class="text-sm font-medium text-gray-900">Guests</p>
            <p class="text-sm text-gray-600">1 guest</p>
          </div>
          <button
            class="w-full bg-gradient-to-r from-pink-500 to-red-500 text-white font-semibold py-3 rounded-lg hover:from-pink-600 hover:to-red-600 transition"
          >
            Reserve
          </button>
          <p class="text-center text-sm text-gray-600 mt-2">
            You won't be charged yet
          </p>
        </div>
      </section>

      <!-- Description -->
      <section class="mb-12">
        <h2 class="text-2xl font-bold text-gray-900 mb-4">About this place</h2>
        <p class="text-gray-700 leading-relaxed mb-4">
          <%= home.description %>
        </p>
        <p class="text-gray-700 leading-relaxed">
          Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do
          eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad
          minim veniam, quis nostrud exercitation ullamco laboris nisi ut
          aliquip ex ea commodo consequat. Duis aute irure dolor in
          reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla
          pariatur.
        </p>
      </section>

      <!-- What this place offers -->
      <section class="mb-12">
        <h2 class="text-2xl font-bold text-gray-900 mb-4">
          What this place offers
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <ul class="space-y-3 text-gray-700">
            <li class="flex items-center gap-3">
              <svg
                class="w-5 h-5 text-gray-600"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 13l4 4L19 7"
                ></path>
              </svg>
              Free Wi-Fi
            </li>
            <li class="flex items-center gap-3">
              <svg
                class="w-5 h-5 text-gray-600"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 13l4 4L19 7"
                ></path>
              </svg>
              Air Conditioning
            </li>
            <li class="flex items-center gap-3">
              <svg
                class="w-5 h-5 text-gray-600"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 13l4 4L19 7"
                ></path>
              </svg>
              Hot Shower
            </li>
          </ul>
          <ul class="space-y-3 text-gray-700">
            <li class="flex items-center gap-3">
              <svg
                class="w-5 h-5 text-gray-600"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 13l4 4L19 7"
                ></path>
              </svg>
              Fully Equipped Kitchen
            </li>
            <li class="flex items-center gap-3">
              <svg
                class="w-5 h-5 text-gray-600"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 13l4 4L19 7"
                ></path>
              </svg>
              Parking Available
            </li>
            <li class="flex items-center gap-3">
              <svg
                class="w-5 h-5 text-gray-600"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M5 13l4 4L19 7"
                ></path>
              </svg>
              24/7 Support
            </li>
          </ul>
        </div>
        <button class="mt-4 text-gray-900 font-semibold underline">
          Show all 10 amenities
        </button>
      </section>

      <!-- Where you'll be -->
      <section class="mb-12">
        <h2 class="text-2xl font-bold text-gray-900 mb-4">Where you'll be</h2>
        <div
          class="bg-gray-200 h-64 rounded-lg flex items-center justify-center"
        >
          <p class="text-gray-600">Map Placeholder</p>
        </div>
        <p class="text-gray-700 mt-4">
          Lorem ipsum dolor sit amet, consectetur adipiscing elit. Vivamus
          lacinia odio vitae vestibulum vestibulum. Cras venenatis euismod
          malesuada. Lorem ipsum dolor sit amet, consectetur adipiscing elit.
          Morbi blandit cursus risus at ultrices.
        </p>
      </section>

      <!-- Reviews -->
      <section class="mb-12">
        <h2 class="text-2xl font-bold text-gray-900 mb-4">Reviews</h2>
        <div class="space-y-6">
          <div class="border-b pb-6">
            <div class="flex items-center gap-4 mb-2">
              <div class="w-10 h-10 bg-gray-300 rounded-full"></div>
              <div>
                <p class="font-semibold text-gray-900">Jane</p>
                <p class="text-gray-600 text-sm">October 2023</p>
              </div>
            </div>
            <p class="text-gray-700">
              Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do
              eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut
              enim ad minim veniam, quis nostrud exercitation ullamco laboris
              nisi ut aliquip ex ea commodo consequat.
            </p>
          </div>
          <div class="border-b pb-6">
            <div class="flex items-center gap-4 mb-2">
              <div class="w-10 h-10 bg-gray-300 rounded-full"></div>
              <div>
                <p class="font-semibold text-gray-900">Mike</p>
                <p class="text-gray-600 text-sm">September 2023</p>
              </div>
            </div>
            <p class="text-gray-700">
              Duis aute irure dolor in reprehenderit in voluptate velit esse
              cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat
              cupidatat non proident, sunt in culpa qui officia deserunt mollit
              anim id est laborum.
            </p>
          </div>
        </div>
        <button class="mt-4 text-gray-900 font-semibold underline">
          Show all 120 reviews
        </button>
      </section>

      <!-- Host Section -->
      <section class="mb-12">
        <h2 class="text-2xl font-bold text-gray-900 mb-4">Meet your host</h2>
        <div class="flex items-center gap-6">
          <div class="w-20 h-20 bg-gray-300 rounded-full"></div>
          <div>
            <p class="text-xl font-semibold text-gray-900">John Doe</p>
            <p class="text-gray-600">Superhost · 5 years hosting</p>
            <p class="text-gray-700 mt-2">
              Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do
              eiusmod tempor incididunt ut labore et dolore magna aliqua.
            </p>
            <button class="mt-2 text-gray-900 font-semibold underline">
              Message Host
            </button>
          </div>
        </div>
      </section>

      <!-- Things to know -->
      <section class="mb-12">
        <h2 class="text-2xl font-bold text-gray-900 mb-4">Things to know</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div>
            <h3 class="font-semibold text-gray-900 mb-2">House rules</h3>
            <ul class="text-gray-700 space-y-1">
              <li>Check-in after 3:00 PM</li>
              <li>Checkout before 11:00 AM</li>
              <li>No smoking</li>
            </ul>
          </div>
          <div>
            <h3 class="font-semibold text-gray-900 mb-2">Safety & property</h3>
            <ul class="text-gray-700 space-y-1">
              <li>Carbon monoxide alarm</li>
              <li>Smoke alarm</li>
              <li>Fire extinguisher</li>
            </ul>
          </div>
          <div>
            <h3 class="font-semibold text-gray-900 mb-2">
              Cancellation policy
            </h3>
            <p class="text-gray-700">Free cancellation for 48 hours.</p>
          </div>
        </div>
      </section>
    </main>

    <!-- Fixed Reserve and Favourite Buttons -->
    <div class="fixed bottom-6 left-0 right-0 flex justify-center gap-4 z-50">
      <a
        href="/reserve?homeId=<%= home.id %>"
        class="px-6 py-3 bg-red-500 hover:bg-red-600 text-white font-semibold rounded-full shadow-lg transition"
      >
        Reserve Now
      </a>
      <%- include('../partials/favourite') %>
    </div>

    <!-- FOOTER -->
    <%- include('../partials/footer'); %>
  </body>
</html>
