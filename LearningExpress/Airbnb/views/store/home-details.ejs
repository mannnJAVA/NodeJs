<!DOCTYPE html>
<html lang="en">
  <%- include("../partials/head", { pageTitle: pageTitle }) %>

  <body class="bg-gray-50">
    <%- include("../partials/header") %>

    <main class="max-w-5xl mx-auto p-6">
      <!-- Top Sticky Area (Title + Reserve Button) -->
      <section
        class="flex justify-between items-center mb-6 sticky top-0 bg-gray-50 py-4 border-b z-10"
      >
        <div>
          <h1 class="text-4xl font-bold"><%= home.title %></h1>

          <div class="mt-2 flex items-center gap-2 text-gray-700">
            <span class="text-yellow-500 text-2xl">★</span>
            <span class="text-lg"><%= home.rating %> / 5</span>
            <span class="text-gray-500">(120 reviews)</span>
          </div>
        </div>

        <!-- Reserve Button Right Side -->
        <a
          href="/reserve"
          class="px-5 py-2 text-lg bg-red-500 text-white rounded-lg hover:bg-red-600 transition shadow-md"
        >
          Reserve
        </a>
      </section>

      <!-- Main Image -->
      <section class="mb-6">
        <img
          src="<%= home.image %>"
          alt="<%= home.title %>"
          class="w-full h-80 object-cover rounded-xl shadow-md"
        />
      </section>

      <!-- Info + Amenities -->
      <section class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
        <!-- Details -->
        <div class="bg-white p-6 rounded-lg shadow">
          <h2 class="text-2xl font-semibold mb-4">Details</h2>

          <p class="text-gray-700">
            <strong>Location:</strong> <%= home.location %>
          </p>

          <p class="text-gray-700 mt-2">
            <strong>Price:</strong> ₹<%= home.price %> / night
          </p>

          <p class="mt-4 text-gray-700 leading-relaxed">
            Lorem ipsum dolor sit amet, consectetur adipiscing elit. Vestibulum
            faucibus neque sed tortor commodo, vel accumsan mi tristique.
            Suspendisse potenti. Aenean sit amet metus quis lorem tristique
            tristique id vitae ipsum.
          </p>
        </div>

        <!-- Amenities -->
        <div class="bg-white p-6 rounded-lg shadow">
          <h2 class="text-2xl font-semibold mb-4">Amenities</h2>

          <ul class="space-y-2 text-gray-700">
            <li>✔ Free Wi-Fi</li>
            <li>✔ Air Conditioning</li>
            <li>✔ Hot Shower</li>
            <li>✔ Kitchen Access</li>
            <li>✔ Parking Available</li>
            <li>✔ 24/7 Security</li>
            <li>✔ Balcony View</li>
          </ul>
        </div>
      </section>

      <!-- Big Reserve Button Bottom -->
      <div class="text-center mt-10">
        <a
          href="/reserve"
          class="px-6 py-3 rounded-lg text-lg bg-blue-600 text-white hover:bg-blue-700 transition shadow"
        >
          Reserve Now
        </a>
      </div>
    </main>
  </body>
</html>
