<!DOCTYPE html>
<html lang="en">
  <%- include('../partials/head', { pageTitle: pageTitle || 'Airbnb Home' }); %>

  <body class="bg-gray-50 min-h-screen font-sans text-gray-800">
    <!-- Header -->
    <%- include('../partials/header'); %>

    <!-- Page heading -->
    <header class="max-w-4xl mx-auto text-center mt-12 px-4">
      <h1 class="text-4xl font-semibold tracking-tight">
        Here are our registered homes
      </h1>
      <p class="mt-2 text-sm text-gray-500">
        Choose a home and reserve your stay.
      </p>
    </header>

    <!-- Controls + Homes list -->
    <main class="mt-8 flex justify-center px-4">
      <div class="bg-white shadow-lg rounded-xl p-6 w-full max-w-6xl">
        <!-- Controls row -->
        <div class="flex items-center justify-between mb-6">
          <div class="flex items-center space-x-2">
            <button
              class="rounded-full border border-slate-300 p-2.5 text-slate-600 hover:text-white hover:bg-slate-800 transition"
              type="button"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-4 h-4"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path
                  d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z"
                />
              </svg>
            </button>
            <button
              class="rounded-full border border-slate-300 p-2.5 text-slate-600 hover:text-white hover:bg-slate-800 transition"
              type="button"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-4 h-4"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path
                  d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 6 4 4 6.5 4c1.54 0 3.04.99 3.57 2.36h.87C14.46 4.99 15.96 4 17.5 4 20 4 22 6 22 8.5z"
                />
              </svg>
            </button>
            <button
              class="rounded-full border border-slate-300 p-2.5 text-slate-600 hover:text-white hover:bg-slate-800 transition"
              type="button"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-4 h-4"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path
                  d="M3 13h2v-2H3v2zM3 17h2v-2H3v2zM3 9h2V7H3v2zM7 13h14v-2H7v2zM7 17h14v-2H7v2zM7 7v2h14V7H7z"
                />
              </svg>
            </button>
            <button
              class="rounded-full border border-slate-300 p-2.5 text-slate-600 hover:text-white hover:bg-slate-800 transition"
              type="button"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-4 h-4"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path d="M10 18h4v-2h-4v2zM3 10v2h18v-2H3zm3-6v2h12V4H6z" />
              </svg>
            </button>

            <span
              class="rounded-full border border-slate-300 py-2 px-4 text-sm text-slate-600"
              >+ 20</span
            >
          </div>

          <div class="w-36">
            <button
              id="reserveTopBtn"
              class="w-full rounded-md bg-slate-800 py-2 px-4 text-sm text-white hover:bg-slate-700 transition"
              type="button"
            >
              Reserve
            </button>
          </div>
        </div>

        <!-- GRID -->
        <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          <% if (homes && homes.length) { %> <% homes.forEach(function(home){ %>

          <article
            tabindex="0"
            class="home-card cursor-pointer rounded-lg border border-slate-200 p-3 bg-white hover:shadow transition"
            data-id="<%= home.id %>"
            data-image="<%= home.image || '/images/placeholder.png' %>"
            data-title="<%= home.title %>"
            data-location="<%= home.location %>"
            data-price="<%= home.price %>"
            data-rating="<%= home.rating || '' %>"
          >
            <div class="h-48 bg-gray-100 rounded-md overflow-hidden">
              <img
                src="<%= home.image || '/images/placeholder.png' %>"
                class="w-full h-full object-cover"
              />
            </div>

            <div class="mt-3">
              <h3 class="text-lg font-semibold text-gray-800">
                <%= home.title %>
              </h3>
              <p class="text-sm text-gray-500 mt-1"><%= home.location %></p>

              <div class="mt-3 flex items-center justify-between">
                <span class="text-sm font-medium text-gray-800">
                  <% if (home.price) { %> $<%= home.price %> / night <% } else {
                  %> Contact for price <% } %>
                </span>

                <div class="flex items-center gap-1">
                  <span class="text-yellow-500 text-lg">★</span>
                  <span class="text-sm text-gray-600"
                    ><%= home.rating || '—' %></span
                  >
                </div>
                <%- include('../partials/favourite-heart', { home: home }) %>
              </div>

              <a
                href="/homes/<%= home.id %>"
                class="mt-4 inline-block w-full bg-blue-600 text-white py-2 px-4 rounded-md hover:bg-blue-700 transition text-center"
                style="
                  background-color: #2563eb;
                  color: white;
                  border: 1px solid #2563eb;
                "
              >
                Show Details
              </a>

              <button
                onclick="window.location.href='/reserve/<%= home.id %>'"
                class="mt-2 w-full bg-red-600 text-white py-2 rounded-md hover:bg-red-700 transition"
              >
                Reserve This Home
              </button>
            </div>
          </article>

          <% }) %> <% } else { %>
          <p class="text-gray-500 col-span-full">No homes found.</p>
          <% } %>
        </section>
      </div>
    </main>

    <!-- Footer -->
    <%- include('../partials/footer'); %>
  </body>
</html>
