<form
  action="/favourites"
  method="POST"
  class="flex flex-col items-center space-y-1"
>
  <!-- Heart button (no border, Instagram-like) -->
  <button type="submit" class="focus:outline-none">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="w-6 h-6 text-gray-400 hover:text-red-500 transition"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      stroke-width="2"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M4.318 6.318a4.5 4.5 0 016.364 0L12 7.636l1.318-1.318a4.5 4.5 0 116.364 
        6.364L12 21.364 4.318 12.682a4.5 4.5 0 010-6.364z"
      />
    </svg>
  </button>

  <!-- Label -->
  <span class="text-xs text-gray-600">Add to Favourite</span>

  <!-- Hidden home ID -->
  <input type="hidden" name="id" value="<%= home.id %>" />
</form>
