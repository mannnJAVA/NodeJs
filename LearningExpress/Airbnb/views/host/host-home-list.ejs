<!DOCTYPE html>
<html lang="en">
  <%- include('../partials/head', { pageTitle: pageTitle || 'Host Homes' }); %>

  <body class="bg-gray-50 min-h-screen font-sans text-gray-800">
    <!-- Header -->
    <%- include('../partials/header'); %>

    <!-- Page heading -->
    <header class="max-w-4xl mx-auto text-center mt-12 px-4">
      <h1 class="text-4xl font-semibold tracking-tight">Your Listed Homes</h1>
      <p class="mt-2 text-sm text-gray-500">
        Manage, edit, or delete your hosted properties.
      </p>
    </header>

    <!-- Homes list -->
    <main class="mt-8 flex justify-center px-4">
      <div class="bg-white shadow-lg rounded-xl p-6 w-full max-w-6xl">
        <!-- GRID -->
        <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          <% if (homes && homes.length) { %> <% homes.forEach(function(home){ %>

          <article
            class="rounded-lg border border-slate-200 bg-white hover:shadow transition overflow-hidden flex flex-col"
          >
            <!-- IMAGE -->
            <div class="h-48 bg-gray-100 w-full overflow-hidden">
              <img
                src="<%= home.image || '/images/placeholder.png' %>"
                class="w-full h-full object-cover"
                alt="<%= home.title || 'Listing image' %>"
              />
            </div>

            <!-- CONTENT -->
            <div class="p-4 flex flex-col gap-3">
              <!-- Title -->
              <h3 class="text-lg font-semibold text-gray-800">
                <%= home.name || home.title || 'Untitled Listing' %>
              </h3>

              <!-- Location -->
              <p class="text-sm text-gray-500">
                Location:
                <span class="text-gray-700">
                  <%= home.location || 'Not specified' %>
                </span>
              </p>

              <!-- Price -->
              <p class="text-sm text-gray-800">
                Price: <% if (home.price) { %>
                <span class="font-medium">$<%= home.price %> / night</span>
                <% } else { %>
                <span class="font-medium">Contact for price</span>
                <% } %>
              </p>

              <!-- Rating -->
              <div class="flex items-center gap-2">
                <span class="text-yellow-500 text-lg">★</span>
                <span class="text-sm text-gray-600">
                  <%= home.rating || '—' %>
                </span>
              </div>

              <!-- BUTTONS -->
              <div class="mt-3 flex flex-col gap-4">
                <!-- Edit -->
                <a
                  href="/host/edit-home/<%= home.id %>"
                  class="w-full bg-blue-600 text-white py-4 px-6 rounded-md hover:bg-blue-700 transition font-bold text-center block shadow-md"
                  style="
                    background-color: #2563eb;
                    color: white;
                    border: 2px solid #1d4ed8;
                    display: block;
                    padding: 16px 24px;
                    font-weight: bold;
                    text-align: center;
                    text-decoration: none;
                    border-radius: 6px;
                    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
                    margin-bottom: 16px;
                  "
                >
                  Edit
                </a>

                <!-- Delete -->
                <form
                  action="/host/delete-home/<%= home.id %>"
                  method="POST"
                  class="w-full"
                >
                  <button
                    type="submit"
                    class="w-full bg-red-600 text-white py-3 px-4 rounded-md hover:bg-red-700 transition font-semibold"
                    onclick="return confirm('Are you sure you want to delete this home?');"
                  >
                    Delete
                  </button>
                </form>
              </div>
            </div>
          </article>

          <% }) %> <% } else { %>
          <p class="text-gray-500 col-span-full text-center">No homes found.</p>
          <% } %>
        </section>
      </div>
    </main>

    <!-- Footer -->
    <%- include('../partials/footer'); %>
  </body>
</html>
