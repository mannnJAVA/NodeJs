<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  </head>
  <body>
    <div class="main w-full min-h-screen bg-zinc-900">
      <div class="form p-10">
        <form action="/create" method="post">
          <input
            type="text"
            class="block w-full py-2 px-5 rounded-md bg-zinc-800 text-white"
            placeholder="Enter your task here..." name="title"
          />
          <textarea
            class="w-full block mt-2 py-2 px-5 resize-none rounded-md bg-zinc-800 text-white mt-2"
            placeholder="Enter task details..." name="details"
          ></textarea>
          <input
            type="submit"
            class="p-2 rounded-md bg-blue-500 text-white mt-2 cursor-pointer"
            value="Create Task"
          />
        </form>
      </div>
      <div class="tasks p-10 flex flex-wrap gap-3">
       <% if(files.length > 0){ %>
  <% files.forEach((val) => { %>

    <div class="task w-72 px-3 py-4 bg-zinc-700">
      <h1 class="text-lg font-bold text-white"><%= val%></h1>
      <a href="/file/<%= val %>" class="text-sm text-blue-500 inline-block mt-3">
        View Details
      </a>
    </div>

  <% }) %>
<% } else { %>
  <h3 class="text-zinc-600">no tasks yet.</h3>
<% } %>
        
      </div>
    </div>
  </body>
</html>
